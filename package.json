{
  "name": "print-mcp",
  "version": "1.0.1",
  "description": "Instant LAN printing MCP server: discovers every printer, renders anything, prints in one call.",
  "license": "AGPL-3.0-or-later",
  "author": "Kritsanai-Krish",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kritsanai-Krish/print-mcp.git"
  },
  "homepage": "https://github.com/Kritsanai-Krish/print-mcp#readme",
  "bugs": "https://github.com/Kritsanai-Krish/print-mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "print",
    "printer",
    "ipp",
    "airprint"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "print-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "scripts"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "tsc -p .",
    "prepack": "npm run build",
    "start": "node dist/index.js",
    "test": "npm run build && node --test --test-concurrency=1 --test-timeout=240000 dist/test/unit.test.js dist/test/setup.test.js dist/test/doctor.test.js dist/test/e2e.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "marked": "^18.1.3",
    "mupdf": "^1.28.1",
    "playwright-core": "^1.64.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
